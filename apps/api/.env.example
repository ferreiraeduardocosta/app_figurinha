# Copie para .env e ajuste.
DATABASE_URL="postgresql://liga:liga@localhost:5432/liga_aurora?schema=public"
PORT=3000
CORS_ORIGENS="http://localhost:8081"
# Loja: compras simuladas sem pagamento (NUNCA em produção; ignorado se NODE_ENV=production)
LOJA_TESTE=0
# Segredo do webhook do RevenueCat (o mesmo valor configurado no painel do RevenueCat)
REVENUECAT_WEBHOOK_TOKEN=
# Semente da simulação da liga (opcional; sem ela usa a de data/temporada1/liga.json)
LIGA_SEMENTE=
# Número de proxies na frente da API (hospedagem). Em produção normalmente 1.
TRUST_PROXY=0
