generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Raridade {
  COMUM
  RARA
  EPICA
  LENDARIA
}

enum TipoFigurinha {
  ESCUDO
  ESTADIO
  TECNICO
  JOGADOR
  MASCOTE
  LENDA
  MOMENTO
}

enum Papel {
  JOGADOR
  ADMIN
}

enum AcaoAdmin {
  CRIAR
  EDITAR
  EXCLUIR
}

enum OrigemPacote {
  DIARIO
  MOEDAS
  COMPRA
  RECOMPENSA
}

model Clube {
  sigla       String       @id
  nome        String       @unique
  cidade      String
  corPrimaria String
  corSecundaria String
  estadio     String
  capacidade  Int
  mascote     String
  lema        String
  identidade  String
  figurinhas  Figurinha[]
}

model Figurinha {
  codigo          String        @id
  numero          Int           @unique
  temporada       Int           @default(1)
  secao           String
  clube           Clube         @relation(fields: [clubeSigla], references: [sigla])
  clubeSigla      String
  tipo            TipoFigurinha
  raridade        Raridade
  nome            String
  apelido         String?
  posicao         String?
  camisa          Int?
  idade           Int?
  destaque        String?
  historia        String
  descricaoVisual String
  ataque          Int?
  defesa          Int?
  tecnica         Int?
  velocidade      Int?
  fisico          Int?
  itens           ItemAlbum[]

  @@index([raridade])
}

model Usuario {
  id                   String    @id @default(uuid())
  apelido              String    @unique
  email                String    @unique
  /// scrypt: "scrypt$N$r$p$sal$hash" (ver src/auth/senha.ts)
  senhaHash            String
  papel                Papel     @default(JOGADOR)
  criadoEm             DateTime  @default(now())
  moedas               Int       @default(0)
  /// Contadores da garantia mínima (ver packages/regras).
  pacotesSemEpica      Int       @default(0)
  pacotesSemLendaria   Int       @default(0)
  /// Último pacote diário grátis aberto (controle de 1 por dia).
  ultimoPacoteDiarioEm DateTime?
  album                ItemAlbum[]
  aberturas            AberturaPacote[]
  sessoes              Sessao[]
}

/// Sessão de login. Guardamos só o hash SHA-256 do token; o token em si fica no aparelho.
model Sessao {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tokenHash String   @unique
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([usuarioId])
}

/// Uma figurinha no álbum do jogador. quantidade = primeira cópia + repetidas.
model ItemAlbum {
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId       String
  figurinha       Figurinha @relation(fields: [figurinhaCodigo], references: [codigo])
  figurinhaCodigo String
  quantidade      Int
  brilhantes      Int       @default(0)
  primeiraEm      DateTime  @default(now())

  @@id([usuarioId, figurinhaCodigo])
}

/// Registro de cada pacote aberto, para auditoria e suporte.
model AberturaPacote {
  id        String       @id @default(uuid())
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  origem    OrigemPacote
  /// Lista de { codigo, raridade, brilhante, garantida }.
  resultado Json
  criadoEm  DateTime     @default(now())

  @@index([usuarioId, criadoEm])
}

/// Histórico de alterações feitas no painel de administração.
model AlteracaoAdmin {
  id              String    @id @default(uuid())
  adminId         String
  adminApelido    String
  acao            AcaoAdmin
  figurinhaCodigo String
  antes           Json?
  depois          Json?
  criadoEm        DateTime  @default(now())

  @@index([criadoEm])
}
