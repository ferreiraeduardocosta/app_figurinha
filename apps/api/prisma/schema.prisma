generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Raridade {
  COMUM
  RARA
  EPICA
  LENDARIA
}

enum TipoFigurinha {
  ESCUDO
  ESTADIO
  TECNICO
  JOGADOR
  MASCOTE
  LENDA
  MOMENTO
}

enum Papel {
  JOGADOR
  ADMIN
}

enum AcaoAdmin {
  CRIAR
  EDITAR
  EXCLUIR
}

enum TipoRecompensa {
  PAGINA
  ALBUM
}

enum StatusAmizade {
  PENDENTE
  ACEITA
}

enum StatusTroca {
  PENDENTE
  ACEITA
  RECUSADA
  CANCELADA
  EXPIRADA
  /// Não pôde ser concluída: alguém já não tinha as repetidas na hora de aceitar.
  FALHOU
}

enum LojaCompra {
  APP_STORE
  PLAY_STORE
  TESTE
}

enum StatusCompra {
  CREDITADA
  ESTORNADA
}

enum OrigemPacote {
  DIARIO
  MOEDAS
  COMPRA
  RECOMPENSA
}

model Clube {
  sigla         String      @id
  nome          String      @unique
  cidade        String
  corPrimaria   String
  corSecundaria String
  estadio       String
  capacidade    Int
  mascote       String
  lema          String
  identidade    String
  figurinhas    Figurinha[]
}

model Figurinha {
  codigo          String        @id
  numero          Int           @unique
  temporada       Int           @default(1)
  secao           String
  clube           Clube         @relation(fields: [clubeSigla], references: [sigla])
  clubeSigla      String
  tipo            TipoFigurinha
  raridade        Raridade
  nome            String
  apelido         String?
  posicao         String?
  camisa          Int?
  idade           Int?
  destaque        String?
  historia        String
  descricaoVisual String
  ataque          Int?
  defesa          Int?
  tecnica         Int?
  velocidade      Int?
  fisico          Int?
  itens           ItemAlbum[]

  @@index([raridade])
}

model Usuario {
  id                   String              @id @default(uuid())
  apelido              String              @unique
  email                String              @unique
  /// scrypt: "scrypt$N$r$p$sal$hash" (ver src/auth/senha.ts)
  senhaHash            String
  papel                Papel               @default(JOGADOR)
  /// Conta excluída pelo jogador e anonimizada (só sobra quando há compras a guardar).
  excluidoEm           DateTime?
  criadoEm             DateTime            @default(now())
  moedas               Int                 @default(0)
  /// Contadores da garantia mínima (ver packages/regras).
  pacotesSemEpica      Int                 @default(0)
  pacotesSemLendaria   Int                 @default(0)
  /// Último pacote diário grátis aberto (controle de 1 por dia).
  ultimoPacoteDiarioEm DateTime?
  /// Pacotes ganhos como recompensa e ainda não abertos.
  pacotesBonus         Int                 @default(0)
  /// Pacotes comprados na loja e ainda não abertos.
  pacotesComprados     Int                 @default(0)
  /// Declarada pelo jogador antes da primeira compra (limites para menores).
  dataNascimento       DateTime?           @db.Date
  album                ItemAlbum[]
  recompensas          Recompensa[]
  aberturas            AberturaPacote[]
  sessoes              Sessao[]
  compras              Compra[]
  missoes              MissaoDia[]
  cuponsResgatados     CupomResgate[]
  cuponsRecebidos      CupomDestinatario[]
  amizadesEnviadas     Amizade[]           @relation("AmizadeSolicitante")
  amizadesRecebidas    Amizade[]           @relation("AmizadeDestinatario")
  trocasPropostas      Troca[]             @relation("TrocaProposta")
  trocasRecebidas      Troca[]             @relation("TrocaRecebida")
}

/// Sessão de login. Guardamos só o hash SHA-256 do token; o token em si fica no aparelho.
model Sessao {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tokenHash String   @unique
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([usuarioId])
}

/// Uma figurinha no álbum do jogador. quantidade = primeira cópia + repetidas.
model ItemAlbum {
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId       String
  figurinha       Figurinha @relation(fields: [figurinhaCodigo], references: [codigo])
  figurinhaCodigo String
  quantidade      Int
  brilhantes      Int       @default(0)
  primeiraEm      DateTime  @default(now())

  @@id([usuarioId, figurinhaCodigo])
}

/// Registro de cada pacote aberto, para auditoria e suporte.
model AberturaPacote {
  id        String       @id @default(uuid())
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  origem    OrigemPacote
  /// Lista de { codigo, raridade, brilhante, garantida }.
  resultado Json
  criadoEm  DateTime     @default(now())

  @@index([usuarioId, criadoEm])
}

/// Histórico de alterações feitas no painel de administração.
model AlteracaoAdmin {
  id              String    @id @default(uuid())
  adminId         String
  adminApelido    String
  acao            AcaoAdmin
  figurinhaCodigo String
  antes           Json?
  depois          Json?
  criadoEm        DateTime  @default(now())

  @@index([criadoEm])
}

/// Recompensa já entregue. A chave única impede entregar a mesma recompensa duas vezes.
/// PAGINA: chave = nome da seção do álbum. ALBUM: chave = "T1" (temporada).
model Recompensa {
  id        String         @id @default(uuid())
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tipo      TipoRecompensa
  chave     String
  criadaEm  DateTime       @default(now())

  @@unique([usuarioId, tipo, chave])
}

/// Pedido de amizade (PENDENTE) ou amizade feita (ACEITA). Só amigos trocam figurinhas.
model Amizade {
  id             String        @id @default(uuid())
  solicitante    Usuario       @relation("AmizadeSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  solicitanteId  String
  destinatario   Usuario       @relation("AmizadeDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  destinatarioId String
  status         StatusAmizade @default(PENDENTE)
  criadaEm       DateTime      @default(now())
  aceitaEm       DateTime?

  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, status])
}

/// Proposta de troca. oferta = figurinhas de quem propõe; pedido = figurinhas de quem recebe.
/// Cada lado é uma lista de { codigo, quantidade }.
model Troca {
  id            String      @id @default(uuid())
  propostaPor   Usuario     @relation("TrocaProposta", fields: [propostaPorId], references: [id], onDelete: Cascade)
  propostaPorId String
  para          Usuario     @relation("TrocaRecebida", fields: [paraId], references: [id], onDelete: Cascade)
  paraId        String
  oferta        Json
  pedido        Json
  status        StatusTroca @default(PENDENTE)
  /// Se esta proposta é uma contraproposta, a proposta original.
  respostaAId   String?
  motivo        String?
  criadaEm      DateTime    @default(now())
  expiraEm      DateTime
  respondidaEm  DateTime?

  @@index([paraId, status])
  @@index([propostaPorId, status])
}

/// Compra creditada pelo servidor (vinda do RevenueCat ou do modo de teste).
/// transacaoId é único: a mesma compra nunca é creditada duas vezes.
model Compra {
  id            String       @id @default(uuid())
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  usuarioId     String
  produtoId     String
  loja          LojaCompra
  ambiente      String
  transacaoId   String       @unique
  pacotes       Int
  moedas        Int
  valorCentavos Int?
  moeda         String?
  status        StatusCompra @default(CREDITADA)
  criadaEm      DateTime     @default(now())
  estornadaEm   DateTime?

  @@index([usuarioId, criadaEm])
}

/// Missão do dia de um jogador. Meta e recompensa ficam copiadas aqui, para
/// mudanças no missoes.json não afetarem missões já entregues.
model MissaoDia {
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  /// Dia em Brasília, "AAAA-MM-DD".
  dia         String
  missaoId    String
  tipo        String
  ordem       Int
  meta        Int
  recompensa  Int
  progresso   Int       @default(0)
  resgatadaEm DateTime?

  @@id([usuarioId, dia, missaoId])
}

/// Partida da liga Craques da Várzea. Placar e gols ficam vazios até a rodada ser simulada.
model Partida {
  id            String    @id @default(uuid())
  temporada     Int
  rodada        Int
  mandante      String
  visitante     String
  dataPrevista  DateTime
  golsMandante  Int?
  golsVisitante Int?
  /// Lista de { sigla, codigo, minuto }.
  gols          Json?
  simuladaEm    DateTime?

  @@unique([temporada, rodada, mandante])
  @@index([temporada, rodada])
}

/// Cupom criado no painel: dá pacotes bônus a quem resgatar o código.
/// Com destinatários, só essas contas podem resgatar (e o cupom aparece no app delas);
/// sem destinatários, vale para qualquer conta, até o limite de usos.
model Cupom {
  id               String              @id @default(uuid())
  /// Sempre em maiúsculas.
  codigo           String              @unique
  pacotes          Int
  /// Texto mostrado ao jogador (ex.: "Presente de boas-vindas").
  descricao        String?
  /// Só para cupons abertos (sem destinatários). Nulo = sem limite.
  maxUsos          Int?
  validoAte        DateTime?
  ativo            Boolean             @default(true)
  criadoPorId      String
  criadoPorApelido String
  criadoEm         DateTime            @default(now())
  destinatarios    CupomDestinatario[]
  resgates         CupomResgate[]

  @@index([criadoEm])
}

model CupomDestinatario {
  cupom     Cupom   @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  cupomId   String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@id([cupomId, usuarioId])
  @@index([usuarioId])
}

/// Cada conta resgata o mesmo cupom no máximo uma vez.
model CupomResgate {
  cupom     Cupom    @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  cupomId   String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  criadoEm  DateTime @default(now())

  @@id([cupomId, usuarioId])
  @@index([usuarioId])
}
